# Docker Compose Environment Variables
# Copy this file to .env and fill in the values
# cp .env.example .env

# ==================== PostgreSQL ====================
# Database credentials
POSTGRES_USER=holistic_user
POSTGRES_PASSWORD=holistic_password
POSTGRES_DB=holistic_db

# ==================== Redis ====================
REDIS_PASSWORD=your_secure_password_here

# ==================== Application ====================
# Environment: localdb, dev, prod
ENV=localdb

# Logger type: json, text
LoggerType=json

# Encryption key for sensitive config
CONFIG_ENCRYPTION_KEY=your_encryption_key_here

# ==================== Optional Image Overrides ====================
# POSTGRES_IMAGE=pgvector/pgvector:pg17
# REDIS_IMAGE=redis:7.0-alpine
